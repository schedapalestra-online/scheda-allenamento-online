rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isZio() {
      return request.auth != null
             && request.auth.token.email == 'EMAIL_DELLO_ZIO';
    }

    // Elenco persone: ognuno registra se stesso; lo zio legge tutti
    match /utenti/{uid} {
      allow read: if isZio() || request.auth.uid == uid;
      allow write: if request.auth.uid == uid || isZio();

      // Scheda e nota della persona: la persona le legge; lo zio le legge e scrive
      match /dati/{docId} {
        allow read:  if request.auth.uid == uid || isZio();
        allow write: if isZio() || (request.auth.uid == uid && docId == 'pesi');
      }
      // Allenamenti e misure: la persona crea/legge i propri; lo zio legge tutto
      match /allenamenti/{docId} {
        allow create: if request.auth.uid == uid;
        allow read:   if request.auth.uid == uid || isZio();
        allow update, delete: if isZio();
      }
      match /misure/{docId} {
        allow create: if request.auth.uid == uid;
        allow read:   if request.auth.uid == uid || isZio();
        allow update, delete: if isZio();
      }
    }
  }
}
